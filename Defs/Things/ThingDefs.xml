<?xml version="1.0" encoding="utf-8"?>

<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>ChComfortNode</defName>
    <label>comfort node</label>
    <description>A compact climate stabilizer. It needs no power and gently keeps its room near the configured temperature.</description>

    <thingClass>Building</thingClass>
    <category>Building</category>
    <tickerType>Rare</tickerType>

    <!-- floor object -->
    <passability>PassThroughOnly</passability>
    <fillPercent>0.05</fillPercent>
    <rotatable>false</rotatable>

    <graphicData>
      <texPath>Things/ChComfy_ComfortNode</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.25,1.25)</drawSize>
    </graphicData>

    <statBases>
      <WorkToBuild>250</WorkToBuild>
      <MaxHitPoints>120</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <Mass>4</Mass>
      <Beauty>0</Beauty>
    </statBases>

    <costList>
      <Steel>15</Steel>
    </costList>

    <comps>
      <li Class="CheatTraits.Comps.CompProperties_ChComfyClimateNode">
        <defaultTargetTemperature>21.1</defaultTargetTemperature>
        <deadbandC>0.25</deadbandC>
        <requireIndoors>true</requireIndoors>
      </li>
      <li Class="CheatTraits.Comps.CompProperties_ComfyGlow">
        <glowRadius>3</glowRadius>
        <glowColor>(255,255,255)</glowColor>
      </li>
    </comps>
    <designationCategory>Temperature</designationCategory>
    <uiOrder>2060</uiOrder>
    <constructEffect>ConstructMetal</constructEffect>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>ChTeslaCoil</defName>
    <label>tesla coil</label>
    <description>A crackling coil that feeds power into the grid and lashes out at nearby hostiles.</description>

    <thingClass>Building</thingClass>
    <graphicData>
      <!-- Placeholder: swap to your real art later -->
      <texPath>Things/ChTesla_TeslaCoil</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.0,1.0)</drawSize>
    </graphicData>

    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.5</fillPercent>
    <pathCost>10</pathCost>
    <rotatable>false</rotatable>

    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <Flammability>0.6</Flammability>
      <Mass>4</Mass>
      <Beauty>0</Beauty>
      <WorkToBuild>250</WorkToBuild>
    </statBases>

    <tickerType>Normal</tickerType>
    <size>(1,1)</size>

    <!-- Buildable in Architect (gated by ChTesla presence via code) -->
    <building>
      <destroySound>BuildingDestroyed_Metal_Small</destroySound>
    </building>

    <costList>
      <Steel>15</Steel>
    </costList>

    <comps>
      <!-- Power: negative consumption = generation; transmitsPower makes it hook to conduits -->
      <li Class="CompProperties_Power">
        <compClass>CompPowerPlant</compClass>
        <basePowerConsumption>-750</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>

      <!-- Optional: lets EMP stun it like other electronics -->
      <li Class="CompProperties_Stunnable">
        <useLargeEMPEffecter>true</useLargeEMPEffecter>
        <affectedDamageDefs>
          <li>EMP</li>
        </affectedDamageDefs>
      </li>

      <!-- Proximity zap -->
      <li Class="CheatTraits.Comps.CompProperties_ChTeslaZap">
        <radius>6</radius>
        <cooldownTicks>180</cooldownTicks>
        <stunTicks>120</stunTicks>
        <damageAmount>45</damageAmount>
        <armorPenetration>0.15</armorPenetration>
        <requirePower>false</requirePower>
      </li>
    </comps>

    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Power</designationCategory>
    <uiOrder>2090</uiOrder>
    <constructEffect>ConstructMetal</constructEffect>
    <specialDisplayRadius>6</specialDisplayRadius>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>ChComfortNodeWall</defName>
    <label>wall comfort node</label>
    <description>A wall-mounted climate stabilizer. Attach it to an interior wall to quietly hold the room near the configured temperature. Needs no power.</description>

    <thingClass>Building</thingClass>
    <category>Building</category>
    <tickerType>Rare</tickerType>
    <altitudeLayer>BuildingOnTop</altitudeLayer>

    <rotatable>true</rotatable>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0.05</fillPercent>

    <graphicData>
      <texPath>Things/ChComfy_ComfortNodeWall</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.0,1.0)</drawSize>
      <drawOffsetNorth>(0,0,0.6)</drawOffsetNorth>
      <drawOffsetSouth>(0,0,-0.3)</drawOffsetSouth>
      <drawOffsetEast>(0.4,0,0)</drawOffsetEast>
      <drawOffsetWest>(-0.4,0,0)</drawOffsetWest>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>

    <terrainAffordanceNeeded IsNull="True" />

    <statBases>
      <WorkToBuild>200</WorkToBuild>
      <MaxHitPoints>80</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <Mass>2</Mass>
      <Beauty>0</Beauty>
    </statBases>

    <costList>
      <Steel>10</Steel>
    </costList>

    <building>
      <isEdifice>false</isEdifice>
      <isAttachment>true</isAttachment>
    </building>

    <placeWorkers>
      <li>Placeworker_AttachedToWall</li>
    </placeWorkers>

    <comps>
      <li Class="CheatTraits.Comps.CompProperties_ChComfyClimateNode">
        <defaultTargetTemperature>21.1</defaultTargetTemperature>
        <deadbandC>0.25</deadbandC>
        <requireIndoors>true</requireIndoors>
      </li>
      <li Class="CheatTraits.Comps.CompProperties_ComfyGlow">
        <glowRadius>2</glowRadius>
        <glowColor>(255,255,255)</glowColor>
      </li>
    </comps>

    <designationCategory>Temperature</designationCategory>
    <uiOrder>2061</uiOrder>
    <constructEffect>ConstructMetal</constructEffect>
  </ThingDef>

