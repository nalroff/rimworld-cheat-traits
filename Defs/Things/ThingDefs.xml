    </comps>

    <designationCategory>Power</designationCategory>
    <uiOrder>2091</uiOrder>
    <constructEffect>ConstructMetal</constructEffect>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>ChFloragenCore</defName>
    <label>floragen core</label>
    <description>A biotechnical growth engine that accelerates nearby flora. Plants within its field grow rapidly regardless of season, temperature, or light.</description>

    <thingClass>Building</thingClass>
    <category>Building</category>
    <tickerType>Rare</tickerType>

    <passability>PassThroughOnly</passability>
    <fillPercent>0.05</fillPercent>
    <rotatable>false</rotatable>

    <graphicData>
      <texPath>Things/ChGreenThumb_FloragenCore</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.25,1.25)</drawSize>
    </graphicData>

    <statBases>
      <WorkToBuild>250</WorkToBuild>
      <MaxHitPoints>120</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <Mass>4</Mass>
      <Beauty>0</Beauty>
    </statBases>

    <costList>
      <Steel>15</Steel>
    </costList>

    <comps>
      <li Class="CheatTraits.Comps.CompProperties_ChFloragenCore">
        <radius>12</radius>
        <scanIntervalTicks>2000</scanIntervalTicks>
        <growthMultiplier>3</growthMultiplier>
        <maxTrackedPlantsPerMap>1200</maxTrackedPlantsPerMap>
      </li>
    </comps>

    <designationCategory>Misc</designationCategory>
    <uiOrder>2065</uiOrder>
    <constructEffect>ConstructMetal</constructEffect>
    <specialDisplayRadius>11.9</specialDisplayRadius>
  </ThingDef>
</Defs>
