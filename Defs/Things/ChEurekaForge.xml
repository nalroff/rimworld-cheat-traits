<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>ChEurekaForge</defName>
    <label>eureka forge</label>
    <description>A trait-gated workbench attuned to an Ascendant's intellect. Every quadrum the Ascendant has a Eureka — a flash of insight that exposes two random recipes from a curated pool for three in-game days. Outside of an active Eureka, the forge cannot be used to craft. Recipes use the assigned crafter's normal skills and stats; an Artificer at the bench will still produce Excellent/Masterwork/Legendary results.</description>

    <thingClass>RimWorld.Building_WorkTable</thingClass>
    <category>Building</category>

    <graphicData>
      <texPath>Things/Building/Production/TableSmithingFueled</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3.5,1.5)</drawSize>
      <shaderType>CutoutComplex</shaderType>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>

    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <rotatable>true</rotatable>

    <size>(3,1)</size>

    <statBases>
      <WorkToBuild>600</WorkToBuild>
      <MaxHitPoints>250</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Mass>20</Mass>
      <Beauty>2</Beauty>
    </statBases>

    <costList>
      <Steel>75</Steel>
      <WoodLog>30</WoodLog>
    </costList>

    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>

    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>

    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
      <buildingTags>
        <li>Production</li>
      </buildingTags>
    </building>

    <recipes>
      <li>ChEureka_Luciferium</li>
      <li>ChEureka_Hyperweave</li>
      <li>ChEureka_Components</li>
      <li>ChEureka_AdvancedComponents</li>
      <li>ChEureka_GlitterworldMedicine</li>
      <li MayRequire="ludeon.rimworld.anomaly">ChEureka_Bioferrite</li>
      <li MayRequire="ludeon.rimworld.biotech">ChEureka_ArchiteCapsule</li>
    </recipes>

    <comps>
      <li Class="CheatTraits.Comps.CompProperties_ChEurekaForgeInspect" />
    </comps>

    <designationCategory>Production</designationCategory>
    <uiOrder>2700</uiOrder>
    <constructEffect>ConstructMetal</constructEffect>
  </ThingDef>

</Defs>
