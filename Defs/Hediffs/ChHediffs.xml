  <!-- ============================================================
       ChBard — support-hero aura
       ============================================================ -->

  <!-- Invisible state carrier on the Bard. Holds the active aura mode and
       the mode-switch cooldown end tick (see Hediff_ChBardConductor). Never
       decays on its own; the applier adds/removes it with the trait. -->
  <HediffDef>
    <defName>ChBard_Conductor</defName>
    <hediffClass>CheatTraits.Hediffs.Hediff_ChBardConductor</hediffClass>
    <label>bard's aura</label>
    <description>This pawn is projecting a commanding aura that empowers nearby colonists.</description>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <duplicationAllowed>false</duplicationAllowed>
    <defaultLabelColor>(0.85, 0.75, 0.35)</defaultLabelColor>
  </HediffDef>

  <!-- The four ramping buff hediffs. Each starts faint and is bumped up in
       severity every aura scan while the ally stays in range (capped at 1.0);
       the negative SeverityPerDay comp decays it to nothing (~3h) and the
       hediff auto-removes at severity 0 once the ally leaves the aura. Three
       severity stages give the visible "charging up". -->

  <HediffDef>
    <defName>ChBard_WarAnthem</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>war anthem</label>
    <description>A Bard's battle hymn sharpens every strike and steadies every shot. The effect grows the longer you fight at their side.</description>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <initialSeverity>0.05</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <duplicationAllowed>false</duplicationAllowed>
    <defaultLabelColor>(0.9, 0.5, 0.4)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-8.0</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>faint</label>
        <statOffsets>
          <MeleeHitChance>0.06</MeleeHitChance>
        </statOffsets>
        <statFactors>
          <MeleeDamageFactor>1.10</MeleeDamageFactor>
          <MeleeCooldownFactor>0.93</MeleeCooldownFactor>
          <AimingDelayFactor>0.90</AimingDelayFactor>
        </statFactors>
      </li>
      <li>
        <label>rising</label>
        <minSeverity>0.4</minSeverity>
        <statOffsets>
          <MeleeHitChance>0.12</MeleeHitChance>
          <MeleeDodgeChance>0.06</MeleeDodgeChance>
          <ShootingAccuracyPawn>2</ShootingAccuracyPawn>
        </statOffsets>
        <statFactors>
          <MeleeDamageFactor>1.20</MeleeDamageFactor>
          <MeleeCooldownFactor>0.87</MeleeCooldownFactor>
          <AimingDelayFactor>0.80</AimingDelayFactor>
        </statFactors>
      </li>
      <li>
        <label>resounding</label>
        <minSeverity>0.8</minSeverity>
        <statOffsets>
          <MeleeHitChance>0.18</MeleeHitChance>
          <MeleeDodgeChance>0.10</MeleeDodgeChance>
          <ShootingAccuracyPawn>3</ShootingAccuracyPawn>
        </statOffsets>
        <statFactors>
          <MeleeDamageFactor>1.30</MeleeDamageFactor>
          <MeleeCooldownFactor>0.80</MeleeCooldownFactor>
          <AimingDelayFactor>0.70</AimingDelayFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

