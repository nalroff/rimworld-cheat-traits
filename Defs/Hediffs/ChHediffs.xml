  <HediffDef>
    <defName>ChSuperSoldier</defName>
    <hediffClass>CheatTraits.Hediffs.Hediff_ChSuperSoldier</hediffClass>
    <label>super soldier</label>
    <description>Wired into a peak combat state by arcane augmentation. Reflexes, durability, and weapons handling are pushed to lethal extremes. The augmentation also conjures a full Legendary spacer-tier loadout that exists only while the buff lasts.</description>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <duplicationAllowed>false</duplicationAllowed>
    <defaultLabelColor>(0.6, 0.6, 1.0)</defaultLabelColor>
    <comps>
      <!-- 5000 ticks = 2 in-game hours. -->
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>5000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <!-- Nimble trait parity: +15 melee dodge, 10% trap-spring chance. -->
        <statOffsets>
          <MeleeDodgeChance>15</MeleeDodgeChance>
        </statOffsets>
        <statFactors>
          <!-- 4x effective survivability — replaces the shield belt's burst
               absorption with permanent damage reduction since the belt
               would block the conjured charge rifle. -->
          <IncomingDamageFactor>0.25</IncomingDamageFactor>
          <PawnTrapSpringChance>0.1</PawnTrapSpringChance>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

