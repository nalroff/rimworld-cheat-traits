<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    These abilities are intentionally non-psycasts:
      - No ParentName="PsycastBase" — PsycastBase sets abilityClass=Psycast and
        verbClass=Verb_CastPsycast, both of which need Royalty's psyfocus/entropy
        tracker to run.
      - No Ability_EntropyGain / Ability_PsyfocusCost — those stats are Royalty-only.
      - verbClass=Verb_CastAbility is the base-game verb. Cooldown/charges come
        from the base AbilityDef fields (cooldownTicksRange, charges,
        cooldownPerCharge), which work without any DLC.
  -->

  <AbilityDef>
    <defName>ChLightningBolt</defName>
    <label>lightning bolt</label>
    <description>Call down a bolt of lightning on a target. The strike inflicts heavy damage, scorches everything in a small radius, and ignites secondary fires.</description>
    <iconPath>UI/Abilities/Flashstorm</iconPath>
    <hostile>true</hostile>
    <aiCanUse>false</aiCanUse>
    <cooldownTicksRange>12500</cooldownTicksRange>
    <charges>3</charges>
    <cooldownPerCharge>true</cooldownPerCharge>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>0.5</warmupTime>
      <range>45</range>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetMechs>true</canTargetMechs>
        <canTargetBuildings>true</canTargetBuildings>
        <canTargetItems>true</canTargetItems>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CheatTraits.Comps.CompProperties_AbilityChLightningBolt">
        <shockDamage>120</shockDamage>
        <shockRadius>1.5</shockRadius>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef>
    <defName>ChTeleportOther</defName>
    <label>teleport other</label>
    <description>Reach across the weave and pull any humanlike pawn on the map to the caster's side. The target appears at the nearest standable cell, briefly stunned by the displacement.</description>
    <iconPath>UI/Abilities/Beckon</iconPath>
    <hostile>false</hostile>
    <aiCanUse>false</aiCanUse>
    <cooldownTicksRange>12500</cooldownTicksRange>
    <charges>2</charges>
    <cooldownPerCharge>true</cooldownPerCharge>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>0.5</warmupTime>
      <!-- Effectively unlimited — vanilla maps cap at 400x400, this clears them all. -->
      <range>9999</range>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>false</canTargetAnimals>
        <canTargetMechs>false</canTargetMechs>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetItems>false</canTargetItems>
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CheatTraits.Comps.CompProperties_AbilityChTeleportOther">
        <searchRadius>12</searchRadius>
        <stunTicks>30~60</stunTicks>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef>
    <defName>ChMassBerserk</defName>
    <label>mass berserk</label>
    <description>Unleash a wave of psychic rage at a chosen point. Every hostile creature within twelve cells — humanlike, animal, or mechanoid — is driven into a berserk frenzy, attacking the nearest target including their own allies.</description>
    <iconPath>UI/Abilities/BerserkPulse</iconPath>
    <hostile>true</hostile>
    <aiCanUse>false</aiCanUse>
    <cooldownTicksRange>12500</cooldownTicksRange>
    <statBases>
      <!-- Ability_Duration is a base-game stat; consumed by CompAbilityEffect_GiveMentalState.TryGiveMentalState. -->
      <Ability_Duration>600</Ability_Duration>
    </statBases>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>0.5</warmupTime>
      <range>45</range>
      <requireLineOfSight>true</requireLineOfSight>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetMechs>true</canTargetMechs>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetItems>false</canTargetItems>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CheatTraits.Comps.CompProperties_AbilityChMassBerserk">
        <effectRadius>12</effectRadius>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef>
    <defName>ChSuperSoldier</defName>
    <label>super soldier</label>
    <description>Conjure a temporary Legendary spacer-tier loadout onto a friendly humanlike and wire their reflexes to a tactical combat state. For two hours: Cataphract armor and helmet plus an overclocked charge rifle materialize on the target, their Shooting and Melee skills max out, their flesh takes a quarter of incoming damage, wounds knit closed steadily, and even a sworn pacifist will fight. When the spell fades, the conjured gear disintegrates.</description>
    <iconPath>Things/Item/Equipment/WeaponRanged/ChargeRifle</iconPath>
    <hostile>false</hostile>
    <aiCanUse>false</aiCanUse>
    <cooldownTicksRange>12500</cooldownTicksRange>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>0.5</warmupTime>
      <!-- Effectively unlimited — vanilla maps cap at 400x400, this clears them all. -->
      <range>9999</range>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>false</canTargetAnimals>
        <canTargetMechs>false</canTargetMechs>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetItems>false</canTargetItems>
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CheatTraits.Comps.CompProperties_AbilityChSuperSoldier" />
    </comps>
  </AbilityDef>

  <AbilityDef>
    <defName>ChBond</defName>
    <label>bond pawns</label>
    <description>Cast on a humanlike to begin a bond. After the first pick, choose a second humanlike — the two are locked into near-maximum compatibility: opinion of 100 each way, deep talks fire constantly, fights nearly vanish, and romance chance reaches 100% whenever the engine already permits it (orientation, age, species, and gene blocks still apply). Casting on a bonded pair again breaks the bond. If the second pick is cancelled, the cooldown is refunded.</description>
    <iconPath>UI/Commands/GatherSpotActive</iconPath>
    <hostile>false</hostile>
    <aiCanUse>false</aiCanUse>
    <cooldownTicksRange>12500</cooldownTicksRange>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>0.5</warmupTime>
      <range>45</range>
      <requireLineOfSight>true</requireLineOfSight>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>false</canTargetAnimals>
        <canTargetMechs>false</canTargetMechs>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetItems>false</canTargetItems>
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CheatTraits.Comps.CompProperties_AbilityChBond" />
    </comps>
  </AbilityDef>
</Defs>
