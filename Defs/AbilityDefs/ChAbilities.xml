  <AbilityDef>
    <defName>ChReforge</defName>
    <!-- Utility ability: keep its gizmo available without drafting.
         displayGizmoWhileUndrafted shows the gizmo; disableGizmoWhileUndrafted
         (default true) must be flipped off too or it stays greyed out with
         "Must be drafted". Matches the vanilla Counsel ability. -->
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <label>reforge</label>
    <description>Rework the quality of any carried item or sculpture with a quality rating — weapons, apparel, art, and other crafted goods. Installed furniture and other buildings are the Engineer's Retrofit. The reroll uses the Artificer's 60/30/10 Excellent/Masterwork/Legendary weights and always replaces the current quality, even if the new roll is lower.</description>
    <!-- Vanilla Core hammer icon; kept distinct from Retrofit's home-area icon. -->
    <iconPath>UI/Buttons/AutoRebuild</iconPath>
    <hostile>false</hostile>
    <aiCanUse>false</aiCanUse>
    <cooldownTicksRange>12500</cooldownTicksRange>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>0.5</warmupTime>
      <range>15</range>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>false</canTargetPawns>
        <canTargetAnimals>false</canTargetAnimals>
        <canTargetMechs>false</canTargetMechs>
        <canTargetBuildings>true</canTargetBuildings>
        <canTargetItems>true</canTargetItems>
        <canTargetLocations>false</canTargetLocations>
        <!-- Default true filters out non-auto-attackable buildings (chairs, art,
             beds...) and non-auto-attackable items (weapons, apparel...).
             Reforge needs to pick any quality-bearing thing, so flip it off. -->
        <mapObjectTargetsMustBeAutoAttackable>false</mapObjectTargetsMustBeAutoAttackable>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CheatTraits.Comps.CompProperties_AbilityChReforge" />
    </comps>
  </AbilityDef>

  <AbilityDef>
