# Copy this file to .env and fill in your local paths.
# .env is gitignored — never commit it.

# Path to your RimWorld installation directory (contains RimWorldWin64_Data/)
RIMWORLD_PATH=D:\Steam\steamapps\common\RimWorld

# Path to your decompiled RimWorld source (used for IDE navigation, not required to build)
RIMWORLD_DECOMP_PATH=F:\Development\rimworld-decomp
